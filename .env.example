# AmbiSense configuration. Copy to .env and edit. Every value here is read at start-up; the API refuses to
# start (with a message naming the setting) if a value is invalid. Settings marked "editable at runtime"
# can also be changed in the Settings page (administrators only); everything else needs a restart.

# --- Database -------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./ambisense.db
# PostgreSQL example: DATABASE_URL=postgresql+psycopg://ambisense:CHANGE_ME@localhost:5432/ambisense

# --- Storage (directories are created and checked for write access at start-up) ---------------------
# UPLOAD_DIR=videos
# REPORT_DIR=reports
# LOG_DIR=logs
CLASSROOM_REFERENCE_DIR=videos/classroom_references
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_MINUTES=180
MAX_REFERENCE_IMAGE_MB=10

# --- Models -----------------------------------------------------------------------------------------
YOLO_MODEL=yolov8n.pt
FACE_LANDMARKER_MODEL=models/face_landmarker.task
POSE_LANDMARKER_MODEL=models/pose_landmarker_lite.task

# --- Network safety ---------------------------------------------------------------------------------
# Explicit origins only (a wildcard is rejected because the API allows credentials).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated host names the API will answer to. "*" is fine for local use; restrict it in production.
TRUSTED_HOSTS=*

# --- Authentication ---------------------------------------------------------------------------------
# With AUTH_ENABLED=false every caller acts as a local administrator (development only).
AUTH_ENABLED=false
AUTH_MODE=TOKEN
# Required (32+ characters) when AUTH_ENABLED=true and AUTH_MODE=TOKEN. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ISSUER=ambisense
AUTH_AUDIENCE=ambisense-api

# --- Rate limiting ----------------------------------------------------------------------------------
# Per client IP, per minute. "memory" is per process (development, demo, single worker).
# "redis" shares counters across workers: needs REDIS_URL and the optional `redis` package.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_ANALYTICS_PER_MINUTE=120
RATE_LIMIT_REPORT_PER_MINUTE=60

# --- Processing -------------------------------------------------------------------------------------
# IN_PROCESS runs jobs inside the API process (local/demo only; jobs do not survive a restart).
JOB_RUNNER_MODE=IN_PROCESS
DEMO_MODE=false
PROCESS_EVERY_N_FRAMES=3
YOLO_CONFIDENCE=0.35
TRACKING_CONFIDENCE=0.35
MINIMUM_TRACK_OBSERVATIONS=3
MINIMUM_TRACK_DURATION=1.0
TRACK_TIMEOUT=3.0
TRACK_REENTRY_WINDOW=8.0
TRACK_IOU_GATE=0.55
MINIMUM_METRIC_COVERAGE=0.2
EXPECTED_STUDENTS=40
TOTAL_SEATS=40

# --- Thresholds (editable at runtime; not validated on real classroom footage) --------------------------
EMA_ALPHA=0.4
EAR_THRESHOLD=0.21
YAWN_THRESHOLD=0.6
DROWSINESS_DURATION=2.0
YAWN_MIN_DURATION=1.0
HEAD_YAW_THRESHOLD=18.0
HEAD_PITCH_THRESHOLD=18.0
ATTENTION_THRESHOLD=0.5
DISTRACTION_MIN_DURATION=3.0
AGGREGATION_INTERVAL=5.0
PRIVACY_MODE=true
SHOW_OVERLAYS=true

# --- Retention (editable at runtime) ----------------------------------------------------------------
RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_ENABLED=true
# Starting the API never changes existing sessions. The background cleanup loop runs ONLY when SCHEDULED_CLEANUP_ENABLED=true
# (first run one interval after start); the two switches below then choose which tasks it performs.
# Manual alternative (recommended locally): GET /api/v1/system/cleanup-test-sessions/preview, then
# POST /api/v1/system/cleanup-test-sessions?confirm=true.
SCHEDULED_CLEANUP_ENABLED=false
TEST_SESSION_CLEANUP_ENABLED=false
TEST_SESSION_CLEANUP_AGE_HOURS=24
# ARCHIVE hides flagged test sessions; DELETE permanently removes them (and their files) after the age above.
TEST_SESSION_CLEANUP_ACTION=ARCHIVE
TEST_SESSION_CLEANUP_INTERVAL_MINUTES=60

# --- Optional audio (disabled by default; needs FFmpeg) ------------------------------------------------
AUDIO_ANALYTICS_ENABLED=false
AUDIO_SAMPLE_RATE=16000
AUDIO_VAD_THRESHOLD=0.02
AUDIO_MIN_VOICE_SECONDS=0.3
TRANSCRIPTION_PROVIDER=NONE
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_LANGUAGE=auto
DIARIZATION_PROVIDER=NONE
CONTENT_GENERATION_PROVIDER=DETERMINISTIC
EVIDENCE_FUSION_VERSION=1.0

# --- Notifications and logging ------------------------------------------------------------------------
NOTIFICATION_QUALITY_THRESHOLD=45
NOTIFICATION_PARTICIPATION_CHANGE_THRESHOLD=20
LOG_LEVEL=INFO

# --- Front end (Vite dev server only) -----------------------------------------------------------------
# VITE_BACKEND_URL=http://127.0.0.1:8000
